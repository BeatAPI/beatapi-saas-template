# BeatAPI SaaS Template — environment variables
#
# Local development:
#   cp .env.example .env.development   # then fill in the values below
#
# Loader priority (scripts/with-env.ts + vite loadEnvFiles):
#   .env.{NODE_ENV}.local > .env.{NODE_ENV} > .env.local > .env
# So in dev, .env.development is picked up by both `pnpm dev` and the db scripts.
#
# Keep this file minimal: provider credentials (payments, OAuth, email,
# storage, AI, analytics) are configured in the admin panel → Settings and
# stored in the database (encrypted when CONFIG_ENCRYPTION_KEY is set).
# Env vars with the matching names still work as fallbacks — database values
# take precedence — but they don't need to live in this template.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
VITE_APP_URL=http://localhost:3020
VITE_BASE_URL=http://localhost:3020
VITE_APP_NAME=BeatAPI
DATABASE_PROVIDER=postgres
# Set a direct PostgreSQL connection URL from your secret store.
# In Cloudflare production, configure Hyperdrive with the same direct URL.
DATABASE_URL=
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# App (optional — sensible defaults exist in src/config/index.ts)
# ---------------------------------------------------------------------------
VITE_APP_DESCRIPTION=Open SaaS starter for AI products
VITE_APP_LOGO=/logo.png
VITE_GITHUB_REPO_URL=
VITE_WORKSPACE_MODE=canvas
VITE_GENERATION_PROVIDER=beatapi
VITE_GENERATION_PROVIDER_LABEL=BeatAPI
VITE_DEFAULT_LOCALE=en

# Public feature flags (optional)
VITE_EMAIL_VERIFICATION_ENABLED=true
VITE_EMAIL_AUTH_ENABLED=true
VITE_GOOGLE_AUTH_ENABLED=false
VITE_GOOGLE_ONE_TAP_ENABLED=false
VITE_GOOGLE_CLIENT_ID=
VITE_CRISP_ENABLED=false
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=

# New users receive a small balance so the starter can be tested immediately.
INITIAL_CREDITS_ENABLED=true
INITIAL_CREDITS_AMOUNT=100
INITIAL_CREDITS_VALID_DAYS=365

# ---------------------------------------------------------------------------
# Admin settings encryption (recommended)
# ---------------------------------------------------------------------------
# Encrypts secrets saved via admin Settings (AES-256-GCM) in the config table.
# Unset = plaintext storage. Once set, keep it stable — rotating or removing
# it orphans already-encrypted values (they fall back to env values).
# Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DATABASE_PROVIDER options: postgres | postgresql
# sqlite exists only as a local test fixture and is not a production profile.
# DB_SCHEMA=public                    # Postgres schema
# DB_SINGLETON_ENABLED=false          # reuse a single connection (serverless)
# DB_MAX_CONNECTIONS=1

# ---------------------------------------------------------------------------
# Auth (optional — AUTH_URL defaults to VITE_APP_URL)
# ---------------------------------------------------------------------------
# AUTH_URL=http://localhost:3020
# BETTER_AUTH_URL=http://localhost:3020
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
DEFAULT_EMAIL_PROVIDER=resend
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SENDER_EMAIL=
MAILGUN_REGION=us

# ---------------------------------------------------------------------------
# SaaS payments (or configure these in Admin -> Settings -> Payment)
# ---------------------------------------------------------------------------
STRIPE_ENABLED=false
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_SECRET=
DEFAULT_PAYMENT_PROVIDER=stripe
# Map local catalog IDs to optional-provider IDs. Stripe uses dynamic prices.
PAYMENT_CATALOG_JSON={}
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
LEMONSQUEEZY_ENABLED=false
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_SIGNING_SECRET=
LEMONSQUEEZY_TEST_MODE=true
PADDLE_ENABLED=false
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------------
# Generation providers
# ---------------------------------------------------------------------------
# BeatCanvas defaults to BeatAPI. Keep this key server-side; never expose it
# through a VITE_ variable. Future custom providers use the same image/video
# task contract behind a server-side adapter.
BEATAPI_API_BASE_URL=https://api.beatapi.io
BEATAPI_API_KEY=
KIE_API_KEY=
KIE_CALLBACK_URL=http://localhost:3020/api/effects/callback
EVOLINK_API_KEY=
EVOLINK_API_BASE_URL=https://api.evolink.ai/v1
ALIBABA_DASHSCOPE_API_KEY=
ALIBABA_DASHSCOPE_API_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
ALIBABA_WAN_T2V_MODEL=wan2.7-t2v
ALIBABA_WAN_I2V_MODEL=wan2.7-i2v
ALIBABA_WAN_VIDEOEDIT_MODEL=wan2.7-videoedit
VIDU_API_KEY=
VIDU_API_BASE_URL=https://api.vidu.cn/ent/v2
VIDU_CALLBACK_URL=http://localhost:3020/api/effects/callback
VIDU_CALLBACK_SECRET=
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_ARK_VISION_MODEL=
DEEPSEEK_API_KEY=

# Generation task recovery
EFFECTS_GENERATION_TIMEOUT_MS=1800000
EFFECTS_POLL_INTERVAL_MS=20000
# Required only for manually calling /api/effects/process or /api/cleanup-stale-generations
EFFECTS_PROCESS_SECRET=

# ---------------------------------------------------------------------------
# Workspace storage (Cloudflare R2)
# ---------------------------------------------------------------------------
# Required for canvas uploads and generated output persistence.
R2_REGION=auto
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_IMAGE_BUCKET_NAME=
R2_IMAGE_PUBLIC_URL=
R2_VIDEO_BUCKET_NAME=
R2_VIDEO_PUBLIC_URL=
R2_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Launch payment provider (ZPAY)
# ---------------------------------------------------------------------------
ZPAY_PID=
ZPAY_KEY=
ZPAY_GATEWAY_URL=https://zpayz.cn
ZPAY_PRICE_CNY_CREDITS_BASIC=
ZPAY_PRICE_CNY_CREDITS_STANDARD=
ZPAY_PRICE_CNY_CREDITS_PREMIUM=

# ---------------------------------------------------------------------------
# Optional widgets / anti-abuse
# ---------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=
