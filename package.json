{
  "name": "beatapi-saas-template",
  "version": "0.1.0",
  "description": "Production-ready TanStack Start template for building AI SaaS products with BeatAPI.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/BeatAPI/beatapi-saas-template#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/BeatAPI/beatapi-saas-template.git"
  },
  "bugs": {
    "url": "https://github.com/BeatAPI/beatapi-saas-template/issues"
  },
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3020",
    "test": "sh -c 'rg --files src -g \"*.test.ts\" -g \"*.test.tsx\" | sort | xargs node --import tsx --test'",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --output-structure message-modules --strategy url cookie baseLocale --silent",
    "pretypecheck": "pnpm i18n:compile",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm i18n:check && pnpm build",
    "licenses:check": "pnpm licenses list --prod --json > /dev/null",
    "prebuild": "node scripts/db-setup.mjs",
    "build": "vite build && node scripts/sanitize-output.mjs",
    "start": "node .output/server/index.mjs",
    "prevercel:build": "NODE_ENV=production node scripts/db-setup.mjs",
    "vercel:build": "NITRO_PRESET=vercel vite build && node scripts/sanitize-output.mjs",
    "precf:build": "NODE_ENV=production node scripts/db-setup.mjs",
    "cf:build": "NITRO_PRESET=cloudflare_module vite build && node scripts/sanitize-output.mjs",
    "cf:deploy": "sh -c 'set -a; if [ -f .env.production ]; then . ./.env.production; elif [ -f .env.local ]; then . ./.env.local; fi; set +a; pnpm cf:build && exec wrangler deploy'",
    "postinstall": "mkdir -p data && (test -f src/config/db/schema.ts || node scripts/db-setup.mjs)",
    "db:setup": "node scripts/db-setup.mjs",
    "db:push": "tsx scripts/with-env.ts drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "tsx scripts/with-env.ts drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx scripts/with-env.ts drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "tsx scripts/with-env.ts drizzle-kit studio --config=drizzle.config.ts",
    "effects:seed": "tsx scripts/with-env.ts tsx scripts/seed-effects.ts",
    "rbac:init": "tsx scripts/with-env.ts tsx scripts/init-rbac.ts",
    "rbac:assign": "tsx scripts/with-env.ts tsx scripts/assign-role.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1069.0",
    "@aws-sdk/s3-request-presigner": "^3.1069.0",
    "@base-ui/react": "^1.3.0",
    "@beehiiv/sdk": "^0.1.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@libsql/client": "^0.14.0",
    "@mdx-js/react": "^3.1.1",
    "@react-email/components": "^1.0.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "1.170.11",
    "@tanstack/react-start": "1.168.19",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.25.0",
    "@tiptap/extension-placeholder": "^3.25.0",
    "@tiptap/react": "^3.25.0",
    "@tiptap/starter-kit": "^3.25.0",
    "@types/mdx": "^2.0.13",
    "@xyflow/react": "12.11.2",
    "aws4fetch": "^1.0.0",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "markdown-it": "^14.2.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-is": "19.2.8",
    "recharts": "3.8.0",
    "resend": "^6.12.4",
    "s3mini": "^0.9.5",
    "simple-flakeid": "^0.0.5",
    "sonner": "^2.0.7",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.18.2",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.4",
    "nitro": "3.0.260603-beta",
    "rollup": "4.62.4",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.16",
    "wrangler": "^4.98.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "esbuild": "0.28.1",
      "js-yaml": "4.3.1",
      "linkify-it": "5.0.2",
      "postcss": "8.5.25",
      "qs": "6.15.3",
      "nanoid@>=4.0.0 <5.1.16": "5.1.16",
      "nanoid@<3.3.18": "3.3.18",
      "uuid": "13.0.1",
      "ws": "8.21.2"
    }
  }
}
